  InteractionText: '?'
  OnInteractEvent:
    m_PersistentCalls:
      m_Calls: []
  TextToShow: "Two brothers, one born in 1999, and the other in 2004.\n\nThey both
    shared a favorite food.\n\t\nTheir father bought two safes, \nThe younger chose
    to deposit 128 coins in the left safe.\nThe other deposited 255 coins in the
    other.\n\nThe older brother formed his password by taking his favorite food and
    encrypting each letter \nthen he added his birth year multiplied by the amount
    of coins he deposited.\n\nThe younger brother formed the password by first raising
    the coin count by the last digit of his birth year \nand then he added his favorite
    food."
  SpriteToShow: {fileID: 0}
  TextPosition: {x: 0, y: 0}
  FontAsset: {fileID: 0}
