  UIAnchor: {fileID: 1167314471}
  InteractionText: 
  TextToShow: "Two brothers, one was born in 1999, and the other was born in 2004.\r\n\r\nThey
    shared a favorite word.\r\n\t\r\nTheir father bought two safes, \r\nThe younger
    chose to deposit 128 coins in the left safe.\r\nThe other deposited 255 coins
    in the other.\r\n\r\nThe older brother formed his password by taking their word,
    changing each letter \nand adding his birth year times the amount of coins.\r\n\r\nThe
    younger brother also used the word, but did not change it, \nhe instead formed
    the password by raising the coin count by the last digit of his birth year \nand
    then added the word."
  SpriteToShow: {fileID: 21300000, guid: 7507f22787a24ba4ba9c8544c26ad988, type: 3}
  TextPosition: {x: 400, y: 200}
  FontAsset: {fileID: 11400000, guid: 8e0c72db8890fcf44ba1a12123222608, type: 2}
