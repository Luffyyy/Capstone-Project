MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1570646624159032860}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d99fe39e179c8bf41957090ee22e429d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSay
  LinesToSay:
  - Line: Nice, you found it.
    Clip: {fileID: 8300000, guid: 0cf54d5cd93036c4cbc9ac21417abf9c, type: 3}
  - Line: "Sometimes devices in the room are connected to each other, \nsometimes
      they require a special port for communication and sometimes they do not. "
    Clip: {fileID: 8300000, guid: f610610b409d899488ae73b8e5f82c13, type: 3}
  - Line: 'This specific terminal is connected to the right terminal with a specific
      port. Maybe find a clue for it?

      Try to turn it on for your buddy.'
    Clip: {fileID: 8300000, guid: 00eeaf23aa8d52b45b68e31c5ad9bca9, type: 3}
  Lines: []
  SayOnAwake: 0
  SayOnce: 1
